 public class ContinuousArraySum {

    public static void main(String[] args) {

        int[] arr = {-1, 0, 1, 2, -1, -4};

        int sum = 0;

        // Find sum of continuous array elements
        for (int i = 0; i < arr.length; i++) {
            sum = sum + arr[i];
        }

        // Display result
        System.out.println("Sum of array elements = " + sum);
    }
}
